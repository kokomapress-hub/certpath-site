/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

/data/*.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json

# books.json is the storefront catalog -- must stay fresh so catalog edits show
# immediately. Revalidate every load (etag -> cheap 304 when unchanged). This rule
# is more specific / later, so it overrides the /data/*.json rule above for this file.
/data/books.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/json

/css/*
  Cache-Control: public, max-age=31536000

/js/*
  Cache-Control: public, max-age=31536000

/pdf-organizer/*
  Cache-Control: no-cache, must-revalidate

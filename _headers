/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Revalidate every load so storefront/catalog edits show immediately. Files carry
# etags, so unchanged data (incl. the large question banks) returns a cheap 304 --
# no re-download. Single rule = no header-merge ambiguity from overlapping globs.
/data/*.json
  Cache-Control: public, max-age=0, must-revalidate
  Content-Type: application/json

/css/*
  Cache-Control: public, max-age=31536000

/js/*
  Cache-Control: public, max-age=31536000

/pdf-organizer/*
  Cache-Control: no-cache, must-revalidate
